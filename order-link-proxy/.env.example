POCKETBASE_URL=https://equity.vasupradah.com/pb
APP_URL=https://equity.vasupradah.com
ORDER_LINK_EMAIL=you@example.com
ORDER_LINK_PASSWORD=changeme

# Origin(s) allowed to call this proxy from a browser. "*" is fine for local
# use; tighten it to your console's actual origin if you host it somewhere.
ALLOWED_ORIGIN=*

PORT=8787

# Rewrite the gateway's http:// short link to https:// before handing it out.
# Set to 0 only if the gateway host is not served over TLS.
FORCE_HTTPS=1
